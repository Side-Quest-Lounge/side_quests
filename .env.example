# Copy to .env.local and fill in values

# Demo mode for judges / local UI walkthrough (bypasses Clerk + uses mock data)
# NEXT_PUBLIC_DEMO_MODE=1

# --- Required for real (non-demo) production ---
# Aurora PostgreSQL (RDS Data API)
AWS_REGION=ap-southeast-2
AURORA_CLUSTER_ARN=
AURORA_SECRET_ARN=
AURORA_DATABASE=friendmatch
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock Titan embeddings (defaults to AWS_REGION)
# BEDROCK_REGION=ap-southeast-2
# When Bedrock RPM quota is exhausted (common on new accounts in ap-southeast-2):
# SEED_DETERMINISTIC=1          — seed script only: hash-based vectors (npm run seed:local)
# ALLOW_DETERMINISTIC_EMBEDDINGS=1 — quiz/profile save falls back when Bedrock throttles

# Claude concierge (optional — fallback copy used if empty)
ANTHROPIC_API_KEY=

# Clerk auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/after-auth
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
# Comma-separated Clerk user IDs allowed to access /api/admin/* and /admin
ADMIN_USER_IDS=

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_ID=
