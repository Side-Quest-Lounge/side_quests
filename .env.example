# Copy to .env.local and fill in values

# Aurora PostgreSQL (RDS Data API)
AWS_REGION=ap-southeast-2
AURORA_CLUSTER_ARN=
AURORA_SECRET_ARN=
AURORA_DATABASE=friendmatch
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Anthropic (agent concierge)
ANTHROPIC_API_KEY=

# Clerk auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated Clerk user IDs allowed to access /api/admin/* and /admin
ADMIN_USER_IDS=

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_ID=
